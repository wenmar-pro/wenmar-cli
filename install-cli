#!/usr/bin/env bash
# install-cli — Install the Wenmar CLI
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/Wenmar-Pro/wenmar-cli/main/install-cli | bash
#
# Options (via environment):
#   WENMAR_BIN_DIR   Where to install the binary
#                    (default: ~/bin if on PATH, else ~/.local/bin if on PATH;
#                     otherwise ~/bin on Windows, ~/.local/bin elsewhere)
#   WENMAR_VERSION   Specific version to install (default: latest)
#   WENMAR_RELEASES_BASE
#                    Base URL serving the release archives + checksums.txt
#                    (default: https://github.com/Wenmar-Pro/wenmar-cli/releases/download)
#                    Useful for mirrors or local testing of unreleased builds.
#
# The SHA-256 checksum is always verified against the release's checksums.txt.

set -euo pipefail

REPO="Wenmar-Pro/wenmar-cli"
BIN_DIR="${WENMAR_BIN_DIR:-}"
VERSION="${WENMAR_VERSION:-}"
RELEASES_BASE="${WENMAR_RELEASES_BASE:-https://github.com/Wenmar-Pro/wenmar-cli/releases/download}"

# Color helpers — respect NO_COLOR (https://no-color.org)
if [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]]; then
  bold()  { printf '\033[1m%s\033[0m' "$1"; }
  green() { printf '\033[32m%s\033[0m' "$1"; }
  red()   { printf '\033[31m%s\033[0m' "$1"; }
  dim()   { printf '\033[2m%s\033[0m' "$1"; }
else
  bold()  { printf '%s' "$1"; }
  green() { printf '%s' "$1"; }
  red()   { printf '%s' "$1"; }
  dim()   { printf '%s' "$1"; }
fi

info()  { echo "  $(green "✓") $1"; }
step()  { echo "  $(bold "→") $1"; }
error() { echo "  $(red "✗ ERROR:") $1" >&2; exit 1; }

find_sha256_cmd() {
  if command -v sha256sum &>/dev/null; then
    echo "sha256sum"
  elif command -v shasum &>/dev/null; then
    echo "shasum -a 256"
  elif command -v sha256 &>/dev/null; then
    echo "sha256 -q"
  else
    error "No SHA256 tool found (need sha256sum, shasum or sha256)"
  fi
}

path_contains_dir() {
  local dir="$1"
  [[ ":$PATH:" == *":$dir:"* ]]
}

default_bin_dir() {
  local platform="$1"

  if path_contains_dir "$HOME/bin"; then
    echo "$HOME/bin"
    return 0
  fi

  if path_contains_dir "$HOME/.local/bin"; then
    echo "$HOME/.local/bin"
    return 0
  fi

  if [[ "$platform" == windows_* ]]; then
    echo "$HOME/bin"
  else
    echo "$HOME/.local/bin"
  fi
}

# detect_platform prints "<os>_<arch>" in the exact shape the release archives use.
detect_platform() {
  local os arch

  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case "$os" in
    darwin) os="darwin" ;;
    linux) os="linux" ;;
    mingw*|msys*|cygwin*) os="windows" ;;
    *) error "Unsupported OS: $os" ;;
  esac

  arch=$(uname -m)
  case "$arch" in
    x86_64|amd64) arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) error "Unsupported architecture: $arch" ;;
  esac

  echo "${os}_${arch}"
}

get_latest_version() {
  local url version api_json

  # Follow the releases/latest redirect to get the version from the final URL.
  # Avoids the GitHub API (no rate limiting).
  if url=$(curl -fsSL -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest"); then
    version="${url##*/}"
    version="${version#v}"
    if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      echo "$version"
      return 0
    fi
  fi

  # Fallback to the GitHub API if redirect parsing fails.
  if api_json=$(curl -fsSL -H 'Accept: application/vnd.github+json' -H 'User-Agent: wenmar-cli-installer' "https://api.github.com/repos/${REPO}/releases/latest"); then
    if [[ $api_json =~ \"tag_name\"[[:space:]]*:[[:space:]]*\"v?([^\"]+)\" ]]; then
      version="${BASH_REMATCH[1]}"
      if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
        echo "$version"
        return 0
      fi
    fi
  fi

  error "Could not determine latest version."
}

verify_checksums() {
  local version="$1" tmp_dir="$2" archive_name="$3"
  local base_url="${RELEASES_BASE}/v${version}"

  step "Verifying checksum..."

  if ! curl -fsSL "${base_url}/checksums.txt" -o "${tmp_dir}/checksums.txt"; then
    error "Failed to download checksums.txt"
  fi

  local expected actual
  expected=$(awk -v f="$archive_name" '$2 == f || $2 == ("*" f) {print $1; exit}' "${tmp_dir}/checksums.txt")
  actual=$(cd "$tmp_dir" && $(find_sha256_cmd) "$archive_name" | awk '{print $1}')

  [[ -n "$expected" && "$expected" == "$actual" ]] \
    || error "Checksum verification failed for $archive_name"

  info "Checksum verified"

  verify_cosign "$version" "$tmp_dir"
}

# verify_cosign verifies the release's checksums.txt signature with cosign.
# If cosign is not installed, warn but continue (SHA-256 is the baseline).
verify_cosign() {
  local version="$1" tmp_dir="$2"
  local base_url="${RELEASES_BASE}/v${version}"

  if ! command -v cosign &>/dev/null; then
    step "cosign not installed — skipping signature verification (SHA-256 already verified)"
    return 0
  fi

  step "Verifying Sigstore signature..."

  if ! curl -fsSL "${base_url}/checksums.txt.bundle" -o "${tmp_dir}/checksums.txt.bundle"; then
    error "Failed to download checksums.txt.bundle"
  fi

  if ! cosign verify-blob --bundle "${tmp_dir}/checksums.txt.bundle" \
    --certificate-identity "https://github.com/${REPO}/.github/workflows/release.yml@refs/tags/v${version}" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    "${tmp_dir}/checksums.txt" &>/dev/null; then
    error "Sigstore signature verification failed"
  fi

  info "Sigstore signature verified"
}

download_binary() {
  local version="$1" platform="$2" tmp_dir="$3"
  local url archive_name ext

  if [[ "$platform" == windows_* ]]; then
    ext="zip"
  else
    ext="tar.gz"
  fi

  archive_name="wenmar_${version}_${platform}.${ext}"
  url="${RELEASES_BASE}/v${version}/${archive_name}"

  step "Downloading wenmar v${version} for ${platform}..."

  if ! curl -fsSL "$url" -o "${tmp_dir}/${archive_name}"; then
    error "Failed to download from $url"
  fi

  verify_checksums "$version" "$tmp_dir" "$archive_name"

  step "Extracting..."
  if [[ "$ext" == "zip" ]]; then
    unzip -q "${tmp_dir}/${archive_name}" -d "$tmp_dir"
  else
    tar -xzf "${tmp_dir}/${archive_name}" -C "$tmp_dir"
  fi

  local binary_name="wenmar"
  if [[ "$platform" == windows_* ]]; then
    binary_name="wenmar.exe"
  fi

  if [[ ! -f "${tmp_dir}/${binary_name}" ]]; then
    error "Binary not found in archive"
  fi

  mkdir -p "$BIN_DIR"
  mv "${tmp_dir}/${binary_name}" "$BIN_DIR/"
  chmod +x "$BIN_DIR/$binary_name"

  info "Installed wenmar to $BIN_DIR/$binary_name"
}

setup_path() {
  if [[ ":$PATH:" == *":$BIN_DIR:"* ]]; then
    return 0
  fi

  step "Adding $BIN_DIR to PATH"

  local shell_rc="" path_line="export PATH=\"$BIN_DIR:\$PATH\""
  case "${SHELL:-}" in
    */zsh)  shell_rc="$HOME/.zshrc" ;;
    */bash) if [[ "$(uname -s)" == "Darwin" ]]; then
              shell_rc="$HOME/.bash_profile"
            else
              shell_rc="$HOME/.bashrc"
            fi ;;
    */fish) shell_rc="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
            path_line="fish_add_path \"$BIN_DIR\"" ;;
    *)      shell_rc="$HOME/.profile" ;;
  esac

  if [[ -f "$shell_rc" ]] && grep -qF "$BIN_DIR" "$shell_rc" 2>/dev/null; then
    info "PATH already configured in $shell_rc"
  else
    mkdir -p "$(dirname "$shell_rc")"
    {
      echo ""
      echo "# Added by wenmar installer"
      echo "$path_line"
    } >> "$shell_rc"
    info "Added to $shell_rc"
    info "Run: source $shell_rc"
  fi
}

verify_install() {
  local platform="$1"
  local binary_name="wenmar"
  if [[ "$platform" == windows_* ]]; then
    binary_name="wenmar.exe"
  fi

  local installed_version
  if installed_version=$("$BIN_DIR/$binary_name" --version 2>&1); then
    info "$(green "${installed_version} installed")"
    return 0
  fi

  error "Installation failed - wenmar not working: $installed_version"
}

print_next_steps() {
  echo ""
  echo "  Next steps:"
  echo "    $(bold "export WENMAR_TOKEN=your-api-token")   Set your API token"
  echo "    $(bold "wenmar customers list --md")           List customers"
  echo "    $(bold "wenmar --help")                        See what you can do"
  echo ""
}

main() {
  step "Installing Wenmar CLI"

  if ! command -v curl &>/dev/null; then
    error "curl is required but not installed"
  fi

  local platform version tmp_dir
  platform=$(detect_platform)

  if [[ -z "$BIN_DIR" ]]; then
    BIN_DIR=$(default_bin_dir "$platform")
  fi

  if [[ -n "$VERSION" ]]; then
    version="$VERSION"
    if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      error "Invalid version '${version}'. Expected semver format (e.g. 1.2.3 or 1.2.3-rc.1)."
    fi
  else
    version=$(get_latest_version)
  fi

  tmp_dir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '${tmp_dir}'" EXIT

  download_binary "$version" "$platform" "$tmp_dir"
  setup_path
  verify_install "$platform"

  print_next_steps
}

if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  main "$@"
fi
